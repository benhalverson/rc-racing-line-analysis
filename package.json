{
  "name": "rc-racing-line-analysis",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "pnpm --dir api dev",
    "start": "pnpm --dir client start",
    "lint": "biome lint api client/src",
    "test": "vitest run && pnpm --dir client ng test --watch=false --runner=vitest",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run typecheck && pnpm run build:client",
    "build:client": "pnpm --dir client run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/node": "^22.0.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}
